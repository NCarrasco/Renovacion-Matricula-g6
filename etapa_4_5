Sección 5 — Comparar baselines y modelos
Se comparan tres baselines y dos modelos, todos evaluados sobre el conjunto de validación (2024) con la misma métrica: ROC-AUC.

# ── CELDA 5.1: BASELINES Y MODELOS CANDIDATOS ────────────────
# Propósito: Entrenar baselines y modelos; comparar en validación con ROC-AUC
#            y con métricas @300, porque la capacidad operativa es fija (300)
# Inputs:    X_train, y_train, X_val, y_val, df_train, df_val, preprocessor
# Outputs:   model_lr, model_rf, tabla comparativa
# ═════════════════════════════════════════════════════════════

from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import roc_auc_score

# 1) Baseline trivial: tasa histórica global
p_global_train = y_train.mean()
val_pred_trivial = np.full(len(y_val), p_global_train)

# 2) Baseline histórico: tasa de renovación por grado
grade_rates = df_train.groupby("grade_level")[target].mean().to_dict()
val_pred_historico = df_val["grade_level"].map(grade_rates).fillna(p_global_train).values

# 3) Baseline operativo: prioridad por saldo pendiente
max_bal = df_train["outstanding_balance"].max()
val_pred_operativo = 1 - (df_val["outstanding_balance"].fillna(0) / max_bal).clip(0, 1).values

# 4) Modelo mínimo interpretable: Regresión Logística
model_lr = Pipeline([
    ("preprocessor", preprocessor),
    ("classifier", LogisticRegression(random_state=RANDOM_STATE, max_iter=1000))
])
model_lr.fit(X_train, y_train)
val_pred_lr = model_lr.predict_proba(X_val)[:, 1]

# 5) Modelo alternativo de complejidad moderada: Random Forest
model_rf = Pipeline([
    ("preprocessor", preprocessor),
    ("classifier", RandomForestClassifier(
        n_estimators=100, max_depth=6, min_samples_split=10,
        min_samples_leaf=5, class_weight="balanced", random_state=RANDOM_STATE
    ))
])
model_rf.fit(X_train, y_train)
val_pred_rf = model_rf.predict_proba(X_val)[:, 1]

# ── Comparación con ROC-AUC (ranking global) ──
resultados_val = pd.DataFrame({
    "Método": ["Baseline trivial", "Baseline histórico", "Baseline operativo",
               "Regresión logística", "Random Forest"],
    "ROC-AUC": [
        roc_auc_score(y_val, val_pred_trivial),
        roc_auc_score(y_val, val_pred_historico),
        roc_auc_score(y_val, val_pred_operativo),
        roc_auc_score(y_val, val_pred_lr),
        roc_auc_score(y_val, val_pred_rf),
    ]
})

# ── Comparación con métricas @300 (lo que de verdad importa: la capacidad es fija) ──
def evaluar_top_k(y_real, score_riesgo, k=300):
    y_real = pd.Series(y_real).reset_index(drop=True)
    idx = np.argsort(-np.asarray(score_riesgo, dtype=float), kind="mergesort")[:k]
    top = y_real.iloc[idx]
    capturados = int(top.sum())
    precision = top.mean()
    recall = capturados / y_real.sum()
    lift = precision / y_real.mean()
    return capturados, precision, recall, lift

y_val_riesgo = 1 - y_val  # 1 = no renovó (evento de interés)
scores_riesgo = {
    "Baseline trivial": val_pred_trivial,
    "Baseline histórico": val_pred_historico,
    "Baseline operativo": val_pred_operativo,
    "Regresión logística": 1 - val_pred_lr,
    "Random Forest": 1 - val_pred_rf,
}

metricas_300 = []
for nombre, score in scores_riesgo.items():
    capturados, precision, recall, lift = evaluar_top_k(y_val_riesgo, score, k=300)
    metricas_300.append([capturados, precision, recall, lift])

resultados_val[["Capturados@300", "Precisión@300", "Recall@300", "Lift@300"]] = metricas_300
resultados_val = resultados_val.round(4)
resultados_val

